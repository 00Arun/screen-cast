{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toolbar",
  "description": "Only the local toolbar may control the app. The website webview gets nothing.",
  "windows": [
    "main"
  ],
  "webviews": [
    "toolbar"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-toggle-cast",
    "allow-new-pin",
    "allow-show-qr",
    "allow-show-about"
  ]
}